# =============================================================================
# PostgreSQL locale per sviluppo e test.
# Copia in `.env.local` e caricalo prima dell'app o dei test:
#   set -a && source .env.local && set +a
# Vedi docs/development.md per i passaggi completi.
# =============================================================================

# --- RUNTIME APP (bot, dashboard, scheduler) ---------------------------------
# Ruolo applicativo soggetto a Row-Level Security.
DATABASE_URL=postgresql+psycopg://expensum_app:devapppassword@localhost:5433/expensum

# --- MIGRAZIONI / ADMIN ------------------------------------------------------
# Ruolo amministrativo usato da Alembic per le migration.
MIGRATION_DATABASE_URL=postgresql+psycopg://expensum:devpassword@localhost:5433/expensum

# --- DDL A RUNTIME -----------------------------------------------------------
# Abilita la creazione automatica dello schema per esperimenti locali.
RUN_RUNTIME_MIGRATIONS=false

# --- TIER DI TEST POSTGRES (pytest -m pg) ------------------------------------
# Valida la RLS e il driver psycopg3 contro il Postgres locale. Il ruolo app serve
# a verificare l'isolamento tra utenti; il ruolo admin a creare/pulire lo schema.
TEST_DATABASE_URL=postgresql+psycopg://expensum_app:devapppassword@localhost:5433/expensum
TEST_DATABASE_URL_ADMIN=postgresql+psycopg://expensum:devpassword@localhost:5433/expensum
