# =============================================================================
# .env.example — Copia in .env e compila tutte le variabili obbligatorie (*)
# NON committare mai il file .env su git.
# Database credentials below are for the local Docker development database only.
# =============================================================================

# ---------------------------------------------------------------------------
# FLASK / DASHBOARD * (OBBLIGATORIA — l'app non parte senza)
# ---------------------------------------------------------------------------
# Secret key per firmare i cookie di sessione. Genera con:
#   python -c 'import secrets; print(secrets.token_urlsafe(48))'
# Se manca, src/dashboard/app.py solleva RuntimeError al boot.
FLASK_SECRET_KEY=

# ---------------------------------------------------------------------------
# TELEGRAM *
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=           # Token del bot da @BotFather
TELEGRAM_CHAT_ID=             # Chat ID del tuo account Telegram (per report automatici)
# Destinatari degli alert operativi (log anomali, servizi down) — comma-separated,
# tutti i co-founder. Se assente ricade sul solo TELEGRAM_CHAT_ID sopra.
ADMIN_ALERT_CHAT_IDS=
# Bot Telegram SEPARATO per gli alert operativi, cosi' non si mischiano con la
# chat dove tracci le tue finanze personali con Expensum. Crealo su @BotFather
# (/newbot), poi manda /start al nuovo bot da ogni chat_id in ADMIN_ALERT_CHAT_IDS
# (un bot non puo' scrivere per primo a un utente che non gli ha mai scritto).
# Se assente ricade sullo stesso TELEGRAM_BOT_TOKEN dell'app.
ALERTS_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=        # Username del bot senza @ (per deep link t.me/<username>?start=...)
INVITE_CODE=                  # Codice invito per registrazione nuovi utenti

# ---------------------------------------------------------------------------
# MISTRAL AI *
# ---------------------------------------------------------------------------
MISTRAL_API_KEY=              # Chiave API da console.mistral.ai
# Modelli configurati in config.py (non modificare qui):
# MISTRAL_SMALL_MODEL = mistral-small-latest
# MISTRAL_LARGE_MODEL = mistral-large-latest

# ---------------------------------------------------------------------------
# GOOGLE VERTEX AI * (trascrizione vocale, GDPR-compliant EU)
# ---------------------------------------------------------------------------
GOOGLE_CLOUD_PROJECT=         # Project ID del tuo progetto Google Cloud
VERTEX_AI_LOCATION=europe-west3  # Regione EU (Francoforte) — non cambiare
# Auth (in ordine di priorità nel codice):
#   1. GOOGLE_APPLICATION_CREDENTIALS_JSON — service account key JSON minificata, incollata
#      qui in .env se preferisci fornire la chiave tramite variabile d'ambiente
#   2. Application Default Credentials via file: GOOGLE_APPLICATION_CREDENTIALS=/path/to/key.json
#   3. Application Default Credentials via login utente: gcloud auth application-default login
# GOOGLE_APPLICATION_CREDENTIALS_JSON=

# ---------------------------------------------------------------------------
# NOTION (OAuth 2.0) *
# ---------------------------------------------------------------------------
NOTION_CLIENT_ID=             # Da Notion Integrations → OAuth app
NOTION_CLIENT_SECRET=         # Da Notion Integrations → OAuth app
NOTION_REDIRECT_URI=https://tuodominio.com/auth/notion/callback

# Nessun NOTION_API_KEY/DATABASE_ID globale: ogni utente si autentica con le proprie
# credenziali OAuth (src/notion_client.py non ha fallback su credenziali condivise).

# Nomi colonne Notion (default già impostati in config.py — cambia solo se diversi)
# NOTION_COL_DATE=Date
# NOTION_COL_CATEGORY=Categories
# NOTION_COL_NAME=Name
# NOTION_COL_AMOUNT=Amount
# NOTION_COL_ACCOUNT=Accounts

# ---------------------------------------------------------------------------
# DATABASE *
# ---------------------------------------------------------------------------
# Local development database URLs. Replace placeholder credentials on your machine.
DATABASE_URL=postgresql+psycopg://expensum_app:devapppassword@localhost:5433/expensum
MIGRATION_DATABASE_URL=postgresql+psycopg://expensum:devpassword@localhost:5433/expensum
# Set false when managing schema changes exclusively through Alembic migrations.
RUN_RUNTIME_MIGRATIONS=false
# SQLite alternative for a lightweight local setup:
# DATABASE_URL=sqlite:///users.db

# ---------------------------------------------------------------------------
# WEB APP
# ---------------------------------------------------------------------------
WEBAPP_BASE_URL=http://localhost:3000   # URL locale della webapp
DASHBOARD_PASSWORD=changeme              # Password accesso dashboard admin Flask
SUPPORT_EMAIL=support@example.com      # Replace with a monitored support address
# Keep registration disabled until your deployment is configured for public sign-up.
PUBLIC_REGISTRATION_ENABLED=false
# Creazione account beta automatica al submit del form Tally (kill-switch: false = disattiva subito)
AUTO_BETA_ACCESS_ENABLED=false
# Tetto account beta auto-creati prima di richiedere creazione manuale
AUTO_BETA_ACCESS_MAX_ACCOUNTS=50

# ---------------------------------------------------------------------------
# POSTHOG (product analytics — EU Cloud)
# ---------------------------------------------------------------------------
POSTHOG_API_KEY=              # Chiave progetto da eu.posthog.com
POSTHOG_HOST=https://eu.i.posthog.com  # NON cambiare: EU data residency GDPR

# ---------------------------------------------------------------------------
# BREVO (email marketing, sede EU) — sync waitlist beta Tally
# ---------------------------------------------------------------------------
BREVO_API_KEY=                # Chiave API da app.brevo.com/settings/keys/api
BREVO_BETA_WAITLIST_LIST_ID= # Optional list ID for your Brevo account
BREVO_MARKETING_LIST_ID= # Optional list ID for your Brevo account
BREVO_SENDER_EMAIL=sender@example.com  # Replace with a sender verified in your account
BREVO_SENDER_NAME=Expensum
TALLY_WEBHOOK_SIGNING_SECRET= # Segreto HMAC del webhook Tally; non esporlo mai al frontend

# ---------------------------------------------------------------------------
# TRIAL LIFECYCLE — drip D7/D14/D25/D29 + downgrade a scadenza (spento in beta)
# ---------------------------------------------------------------------------
TRIAL_AUTOMATION_ENABLED=false # true solo dopo l'uscita dalla beta
TRIAL_DISCOUNT_CODE=           # Codice sconto mostrato nel messaggio D29

# ---------------------------------------------------------------------------
# STRIPE (scaffolding, non ancora attivo — vedi task pagamenti post-beta)
# ---------------------------------------------------------------------------
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# GOOGLE ANALYTICS 4 — Measurement Protocol (eventi custom server-side)
# + gtag.js lato browser (sessioni/attribuzione traffico), caricato SOLO dopo
# consenso cookie "analytics" — vedi frontend/src/components/CookieConsent.tsx
# ---------------------------------------------------------------------------
GA4_MEASUREMENT_ID=           # Da Admin > Data Streams > il tuo stream web
GA4_API_SECRET=                # Admin > Data Streams > Measurement Protocol API secrets
# Stesso Measurement ID di sopra (G-XXXXXXX): è pubblico per design (gtag.js lo
# espone comunque nel browser), NEXT_PUBLIC_* viene inlineato a build time.
NEXT_PUBLIC_GA4_MEASUREMENT_ID=

# ---------------------------------------------------------------------------
# META CONVERSIONS API (server-side, nessun fbevents.js)
# ---------------------------------------------------------------------------
META_PIXEL_ID=                 # ID pixel da Meta Events Manager
META_ACCESS_TOKEN=             # Token di accesso a lunga durata generato dall'Events Manager

# ---------------------------------------------------------------------------
# LOGGING
# ---------------------------------------------------------------------------
# INFO in produzione (default). DEBUG solo in sviluppo locale attivo — genera
# anche logs/debug.jsonl, molto più verboso.
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# SICUREZZA E LIMITI
# ---------------------------------------------------------------------------
MAX_MESSAGES_PER_MINUTE=10    # Rate limiting per utente
MAX_FILE_SIZE_MB=5            # Dimensione massima file (foto/audio)
MAX_MESSAGE_LEN=300           # Lunghezza massima messaggio testo

# ---------------------------------------------------------------------------
# AGENTE FINANZIARIO
# ---------------------------------------------------------------------------
HISTORY_MONTHS=6              # Mesi di storico per analisi trend
ANOMALY_THRESHOLD_PCT=25      # Soglia % per flaggare anomalie di spesa
SCHEDULE_HOUR=7               # Ora invio report mensile (0-23)
SCHEDULE_MINUTE=0             # Minuto invio report mensile

# ---------------------------------------------------------------------------
# GEMINI (legacy — mantenuto solo per compatibilità con vecchio codice)
# In produzione la voce usa Vertex AI (sopra), non questa chiave.
# ---------------------------------------------------------------------------
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
