# Non e' un segreto: solo l'indirizzo interno (localhost) su cui gunicorn
# (expensum-flask) ascolta in produzione. next.config.ts ricadrebbe altrimenti
# sul default di sviluppo locale (localhost:5050, porta scelta per evitare il
# conflitto con AirPlay Receiver su macOS), che in produzione non e' in ascolto:
# le rewrite verso Flask (/login, /register, /admin/*, /auth/*) fallivano con
# un 500 generico privo di Content-Type (causa reale dell'interruzione del
# login web del 2026-09-10). Vedi deployment documentation, unit expensum-webapp.service.
INTERNAL_BACKEND_ORIGIN=http://127.0.0.1:5000
